# Copy to .env and fill in the values. NEVER commit .env (the repo is public).

# Azure OpenAI (the chat model)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_NAME=

# Azure embeddings (pgvector / ChromaDB). Resource address only, no /openai/v1/ at the end.
AZURE_EMBEDDING_ENDPOINT=
AZURE_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Postgres + pgvector (docker compose up -d). From your laptop: localhost:5433.
DATABASE_URL=postgresql://supplyguard:supplyguard@localhost:5433/supplyguard
# Document search (role 3). Optional: these are the defaults.
# hybrid = meaning + exact words (best in the benchmark); also: pgvector, chroma
RETRIEVAL_MODE=hybrid
# An open search whose best match is below this returns nothing ("no reliable source")
RETRIEVAL_MIN_SIMILARITY=0.30

# Neo4j (browser: http://localhost:7475)
NEO4J_URI=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=supplyguard-password

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# External risk service (the trainer's external_info_service.py, started by docker compose)
RISK_SERVICE_URL=http://localhost:8099

# Where the trainer's data package is (relative to the repo root)
DATA_DIR=data

# LangSmith (tracing + evaluation). false = nothing is sent.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=supplyguard-ai

#Chainlit Secret and Password
CHAINLIT_AUTH_SECRET=
DEMO_PASSWORD=
